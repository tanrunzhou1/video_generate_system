# ===== Runtime =====
APP_NAME=Video Generate System BE
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ===== Model API Keys / Endpoints =====
# Fill real keys before running in non-local environments.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ===== Media / Tooling =====
FFMPEG_BIN=ffmpeg

# ===== Storage Paths =====
ASSETS_DIR=./assets
STORAGE_DIR=./storage
LOGS_DIR=./logs

# ===== Workflow Defaults =====
TARGET_DURATION_SEC=60
MAX_RETRY_PER_STAGE=2
WORKFLOW_TIMEOUT_SEC=1800
TOP_K_CANDIDATES=3
CONSISTENCY_THRESHOLD=0.78

# ===== Optional Infra =====
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite:///./storage/app.db
